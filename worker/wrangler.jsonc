{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lirep-public-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://REEMPLAZAR-DOMINIO-PRODUCCION"
  },
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMITER",
      "namespace_id": "1701",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
